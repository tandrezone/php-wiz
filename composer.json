{
    "name": "adao/php-wiz",
    "description": "Local (LAN) control of WiZ smart bulbs over UDP, no cloud required",
    "type": "library",
    "license": "MIT",
    "keywords": ["wiz", "smart bulb", "iot", "udp", "lighting", "home automation"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Adao\\Wiz\\": "src/"
        }
    },
    "bin": ["bin/wiz"],
    "minimum-stability": "stable"
}
